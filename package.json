{
  "name": "darkmoney-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:dashboard-help": "node scripts/check-dashboard-help-keys.mjs",
    "test:parity": "tsc -p tsconfig.parity-tests.json && node scripts/run-parity-smoke.mjs",
    "test:movement-save": "node --experimental-strip-types scripts/test-movement-save-parity.mjs && node --experimental-strip-types scripts/test-movement-idempotency.mjs && node scripts/test-movement-category-parity.mjs && node scripts/test-movement-suggestions-parity.mjs",
    "test:movement-suggestions": "node scripts/test-movement-suggestions-parity.mjs",
    "test:date-format": "node --experimental-strip-types scripts/test-date-format.mjs",
    "test:obligation-plan": "node --experimental-strip-types scripts/test-obligation-plan.mjs",
    "test:subscription-parity": "node --experimental-strip-types scripts/test-subscription-parity.mjs",
    "test:subscription-receipts": "node --experimental-strip-types scripts/test-subscription-receipts.mjs",
    "test:subscription-split-server": "node --experimental-strip-types scripts/test-subscription-split-server.mjs",
    "test:detected-split-web": "node scripts/test-detected-split-web.mjs",
    "test:web-assistant": "node scripts/test-web-assistant.mjs && node scripts/test-dashboard-ai-scope.mjs",
    "test:obligation-notification-ui": "node scripts/test-obligation-notification-ui.mjs",
    "test:notification-parity": "node --experimental-strip-types scripts/test-notification-parity.mjs",
    "test:notification-day": "node scripts/test-notification-day-ui.mjs",
    "test:notification-destination": "node scripts/test-notification-destination.mjs",
    "test:shared-obligations": "node scripts/test-shared-obligations.mjs",
    "test:detected-movement-parity": "node --experimental-strip-types scripts/test-detected-movement-parity.mjs",
    "test:detection-inbox-ui": "node scripts/test-detection-inbox-ui.mjs",
    "test:detection-learning": "node scripts/test-detection-learning.mjs",
    "test:detection-duplicates": "node scripts/test-detection-duplicates.mjs",
    "test:detected-movement-undo": "node --experimental-strip-types scripts/test-detected-movement-undo.mjs",
    "test:detected-movement-split": "node --experimental-strip-types scripts/test-detected-movement-split.mjs",
    "test:recurring-income-parity": "node --experimental-strip-types scripts/test-recurring-income-parity.mjs",
    "test:budget-parity": "node --experimental-strip-types scripts/test-budget-parity.mjs",
    "test:catalog-parity": "node scripts/test-catalog-parity.mjs",
    "test:workspace-sync": "node scripts/test-workspace-sync.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@darkmoney/shared": "github:JorgeGuerrero26/darkmoneyshare",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "^2.78.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
